FROM node:18-alpine AS builder

WORKDIR /app

# package.jsonをコピー
COPY package*.json ./

# 依存関係をインストール
RUN npm ci

# ソースコードをコピー
COPY . .

# TypeScriptをビルド
RUN npm run build

# 本番ステージ
FROM node:18-alpine

WORKDIR /app

# 本番用の依存関係のみインストール
COPY package*.json ./
RUN npm ci --only=production

# ビルド成果物をコピー
COPY --from=builder /app/dist ./dist

# ヘルスチェック用にwgetをインストール
RUN apk add --no-cache wget

EXPOSE 3000

# 非rootユーザーで実行
USER node

CMD ["npm", "run", "start"]

